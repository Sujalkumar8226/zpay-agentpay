# ZPay AgentPay — Environment Variables Config

# Database URL
DATABASE_URL=sqlite:///./zpay.db

# JWT Secret Key
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# AES-256-GCM Master Key (Base64 encoded 32 bytes)
MASTER_ENCRYPTION_KEY=CHANGE_ME_TO_A_BASE64_32_BYTE_KEY

# Stellar Horizon Settings
STELLAR_NETWORK=testnet
# HORIZON_URL=https://horizon-testnet.stellar.org